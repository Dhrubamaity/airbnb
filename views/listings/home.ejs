                            <div>
                                <h3 class="text-xl font-semibold text-white">Paris</h3>
                                <p class="text-gray-300">120+ hotels</p>
                            </div>
                        </div>
                    </div>
                    <div class="relative rounded-xl overflow-hidden h-64">
