<% layout("/layouts/boilerplate") %>

    <body>
        <section class="hero">
            <!-- <div class="hero-img"> -->
            <!-- <img src="/asset/taj.jpg" alt="......."> -->
            <!-- </div> -->
            <div class="hero-content">
                <h1>Find your Perfect <span>getaway</span></h1>
                <p>Discover unique places to stay, experiences, and more — all chosen by Wanderlust.</p>
                <!-- <a href="/listing"><button class="hero-btn button">Explore All ></button></a> -->
            </div>
        </section>
        <div class="index-container">
            <% for(let listing of alllistings){ %>
                <a href="/listing/<%=listing.id%>" class="listing-link">
                    <div class="card index-card">
                        <img src="<%= listing.image%>" class="card-img-top index-card-img" alt="<%=listing.title%>">
                        <div class="card-body">
                            <h6 class="">
                                <%= listing.title %>
                            </h6>
                            <h6 class="card-title">
                                <%= listing.country %>, <%= listing.location %>
                            </h6>
                                <p class="card-text text-purple-700 bg-purple-200 font-xs px-2 w-fit">
                                &#8377; <%= listing.price%>
                            </p>
                        </div>
                    </div>
                </a>
                <% } %>
        </div>

    </body>